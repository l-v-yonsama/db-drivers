{
  "name": "@l-v-yonsama/multi-platform-database-drivers",
  "version": "2.1.0",
  "packageManager": "npm@10.9.4",
  "description": "multi-platform database drivers in TypeScript.",
  "engines": {
    "node": ">= 20"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1103.0",
    "@mermaid-js/parser": "^1.2.0",
    "@types/auth0": "^3.3.9",
    "@types/better-sqlite3": "^7.6.11",
    "@types/bytes": "^3.1.1",
    "@types/humanize-duration": "^3.27.2",
    "@types/jest": "~29.2",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.chunk": "^4.2.9",
    "@types/lodash.isequal": "^4.5.6",
    "@types/memcached": "^2.2.10",
    "@types/mssql": "^9.1.5",
    "@types/node": "22.18.10",
    "@types/oracledb": "^7.0.1",
    "@types/pg": "^8.6.6",
    "@types/pluralize": "^0.0.29",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "~8.67",
    "@typescript-eslint/parser": "~8.67",
    "eslint": "~8.57",
    "eslint-config-prettier": "~8.5",
    "eslint-plugin-jest": "~28.14",
    "jest": "~29.3",
    "prettier": "~2.8",
    "rimraf": "~3.0",
    "ts-jest": "~29.4",
    "tslib": "^2.6.3",
    "tsutils": "~3.21",
    "typescript": "~6.0.3",
    "typescript-json-schema": "^0.67.1"
  },
  "scripts": {
    "start": "node built/src/index.js",
    "clean:build": "rimraf built *.tgz",
    "clean:test": "rimraf coverage tmp __tests__/data/logs/parse/*.json",
    "clean": "npm run clean:build && npm run clean:test",
    "clean:examples": "rimraf built/src/examples",
    "prebuild": "npm run lint",
    "build": "npm run clean:build && tsc -p tsconfig.json",
    "build:watch": "npm run clean:build && tsc -w -p tsconfig.json",
    "build:schema": "typescript-json-schema tsconfig.json LogParseConfig --required --noExtraProps --out schema/log-parse-config.schema.json",
    "build:core": "npm run clean:build && tsc -p tsconfig.release.json && npm run build:schema && cp -r schema built/schema",
    "build:pack": "npm run build:core && npm run clean:examples && npm pack",
    "build:release": "npm run build:core && npm run clean:examples",
    "prepublishOnly": "npm run build:release",
    "lint": "eslint . --ext .ts --ext .mts",
    "lint:fix": "eslint --fix . --ext .ts --ext .mts",
    "examples:cw": "npm run build && node built/src/examples/cw.js",
    "examples:cfn": "npm run build && node built/src/examples/cfn.js",
    "examples:cfn-diagrams": "npm run build && node built/src/examples/cfn/generateDiagrams.js",
    "examples:cfn-diagrams-auto": "npm run build && node built/src/examples/cfn/generateDiagramsAuto.js",
    "examples:dynamo": "npm run build && node built/src/examples/dynamo.js",
    "examples:memcached": "npm run build && node built/src/examples/memcached.js --detectOpenHandles",
    "examples:mysql": "npm run build && node built/src/examples/mysql.js",
    "examples:mysql2": "npm run build && node built/src/examples/mysql2.js",
    "examples:mssql": "npm run build && node built/src/examples/mssql.js",
    "examples:mssql2": "npm run build && node built/src/examples/mssql2.js",
    "examples:postgres": "npm run build && node built/src/examples/postgres.js",
    "examples:rules": "npm run build && node built/src/examples/rules.js",
    "examples:aws": "npm run build && node built/src/examples/aws.js",
    "diagram:cfn:localstack": "npm run build:core && node scripts/generate-cfn-validation-diagram-localstack.js",
    "examples:auth0": "npm run build && node built/src/examples/auth0.js",
    "examples:keycloak": "npm run build && node built/src/examples/keycloak.js",
    "test0": "jest --coverage",
    "test": "npm run clean:test && jest --runInBand",
    "test:util": "npm run clean:test && jest __tests__/util/util.test.ts",
    "test:logParserUtil": "npm run clean:test && jest __tests__/util/logParseUtil.test.ts",
    "test:driver:mysql": "npm run clean:test && jest __tests__/db/drivers/MySQLDriver.test.ts",
    "test:driver:mssql": "npm run clean:test && jest __tests__/db/drivers/SQLServerDriver.test.ts",
    "test:driver:postgres": "npm run clean:test && jest __tests__/db/drivers/PostgresDriver.test.ts",
    "test:driver:sqlite": "npm run clean:test && jest __tests__/db/drivers/SQLiteDriver.test.ts",
    "test:driver:oracle": "npm run clean:test && jest __tests__/db/drivers/OracleDriver.test.ts",
    "test:driver:redis": "npm run clean:test && jest __tests__/db/drivers/RedisDriver.test.ts",
    "test:driver:mqtt": "npm run clean:test && jest __tests__/db/drivers/MqttDriver.test.ts",
    "test:driver:auth0": "npm run clean:test && jest __tests__/db/drivers/Auth0Driver.test.ts",
    "test:driver:keycloak": "npm run clean:test && jest __tests__/db/drivers/KeycloakDriver.test.ts",
    "test:driver:s3": "npm run clean:test && jest __tests__/db/drivers/AwsS3Driver.test.ts",
    "test:driver:sqs": "npm run clean:test && jest __tests__/db/drivers/AwsSQSDriver.test.ts",
    "test:driver:cw": "npm run clean:test && jest __tests__/db/drivers/AwsCloudwatchDriver.test.ts",
    "test:driver:minio": "npm run clean:test && jest __tests__/db/drivers/AwsS3Driver.test.ts",
    "test:helper:sql": "npm run clean:test && jest __tests__/helpers/sql/",
    "test:helper:res:mysql": "npm run clean:test && jest __tests__/helpers/ResourceHelper.mysql.test.ts",
    "test:helper:res:postgres": "npm run clean:test && jest __tests__/helpers/ResourceHelper.postgres.test.ts",
    "test:helper:engine": "npm run clean:test && jest __tests__/helpers/RuleEngine.test.ts",
    "test:helper:resolver": "npm run clean:test && jest __tests__/helpers/CodeResolver.test.ts",
    "prettier": "prettier --config .prettierrc --write .",
    "test:watch": "jest --watch"
  },
  "author": "l-v-yonsama <32474032+l-v-yonsama@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1103.0",
    "@aws-sdk/client-cloudwatch": "^3.1116.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.306.0",
    "@aws-sdk/client-dynamodb": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.279.0",
    "@aws-sdk/client-secrets-manager": "^3.1102.0",
    "@aws-sdk/client-ses": "^3.398.0",
    "@aws-sdk/client-sqs": "^3.398.0",
    "@aws-sdk/client-ssm": "^3.1102.0",
    "@aws-sdk/credential-providers": "^3.279.0",
    "@aws-sdk/lib-dynamodb": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.427.0",
    "@l-v-yonsama/rdh": "^1.1.0",
    "auth0": "^3.7.1",
    "axios": "^1.6.0",
    "bytes": "^3.1.2",
    "csv-parse": "^5.5.3",
    "dayjs": "^1.11.7",
    "dotenv": "^16.3.1",
    "elkjs": "^0.12.0",
    "enum-values": "^1.2.1",
    "humanize-duration": "^3.30.0",
    "ioredis": "^5.3.1",
    "js-yaml": "^4.3.1",
    "json-rules-engine": "^7.3.1",
    "jwt-decode": "^4.0.0",
    "lodash.chunk": "^4.2.0",
    "memcached": "^2.2.2",
    "mime-lite": "^1.0.3",
    "mqtt": "^5.13.1",
    "mssql": "^11.0.1",
    "mysql2": "^3.1.2",
    "openid-client": "^5.6.1",
    "oracledb": "^7.0.1",
    "pg": "^8.9.0",
    "pgsql-ast-parser": "^11.0.1",
    "pluralize": "^8.0.0",
    "short-unique-id": "^4.4.4",
    "sql-formatter": "^15.7.2",
    "sql.js": "1.14.1",
    "web-worker": "^1.5.0",
    "xregexp": "^5.1.2"
  },
  "volta": {
    "node": "22.21.1",
    "npm": "10.9.4"
  },
  "main": "built/src/index.js",
  "types": "built/src/index.d.ts",
  "files": [
    "built/src",
    "built/schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l-v-yonsama/db-drivers.git"
  },
  "keywords": [
    "database clients"
  ],
  "bugs": {
    "url": "https://github.com/l-v-yonsama/db-drivers/issues"
  },
  "homepage": "https://github.com/l-v-yonsama/db-drivers#readme"
}
