{
  "compilerOptions": {
    // See tsconfig.json for why this is pinned explicitly.
    "strict": false,
    "target": "es6",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es7"],
    "removeComments": true,
    "esModuleInterop": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "built",
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "alwaysStrict": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["src/**/*.spec.ts", "__tests__/**/*"]
}
